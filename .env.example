# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Phone OTP Verification Secret (Cryptographic signing key)
OTP_SECRET_KEY=generate_a_random_32_character_secret_key_here

# SMS Gateway Configuration (Choose FAST2SMS, TWILIO, or MSG91)
SMS_PROVIDER=FAST2SMS
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Optional: Twilio Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Optional: MSG91 Configuration (if using MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_template_id
