# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Phone OTP Verification Secret (Cryptographic signing key)
OTP_SECRET_KEY=generate_a_random_32_character_secret_key_here

# SMS Gateway Configuration (Choose FAST2SMS, 2FACTOR, TWILIO, or MSG91)
SMS_PROVIDER=FAST2SMS
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Optional: 2Factor.in Configuration (India dedicated OTP provider)
TWO_FACTOR_API_KEY=your_2factor_api_key_here

# Optional: Twilio Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email OTP Verification (Nodemailer with Free Gmail App Password or Resend)
SMTP_USER=saloriyaofficial@gmail.com
SMTP_PASS=your_16_char_gmail_app_password_here
# Optional if not using Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# RESEND_API_KEY=re_your_resend_api_key_here
