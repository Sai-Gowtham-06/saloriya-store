# Copy this file to .env.local and replace both values with your Supabase project values.
# Use only the project URL and publishable/anon key here. NEVER use a service-role/secret key.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here

